{
    "private": true,
    "scripts": {
        "build:dev": "npm run development",
        "development": "mix",
        "watch": "mix watch",
        "watch-poll": "mix watch -- --watch-options-poll=1000",
        "hot": "mix watch --hot",
        "build:prod": "npm run production",
        "production": "mix --production",
        "build:webpack": "webpack --mode=production --config resources/webpack.config.js",
        "build:blocks": "webpack --mode=production --config resources/webpack.config.js",
        "build": "run-p build:*",
        "i18n:pot:php": "wp-pot --src '**/*.php' --dest-file languages/jankx.pot --domain jankx --package \"Jankx Framework\"",
        "i18n:pot": "npm run i18n:pot:php",
        "i18n:update": "node -e \"require('child_process').execSync('\\\"C:\\\\Program Files\\\\Git\\\\usr\\\\bin\\\\msgmerge.exe\\\" --update --backup=none languages/jankx-vi.po languages/jankx.pot', {stdio: 'inherit'})\"",
        "i18n:compile": "node -e \"require('child_process').execSync('\\\"C:\\\\Program Files\\\\Git\\\\usr\\\\bin\\\\msgfmt.exe\\\" -o languages/jankx-vi.mo languages/jankx-vi.po', {stdio: 'inherit'})\" && po2json languages/jankx-vi.po languages/jankx-vi.json --format=jed1.x",
        "i18n:make": "npm run i18n:pot && npm run i18n:update && npm run i18n:compile"
    },
