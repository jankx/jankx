{
  "name": "jankx",
  "version": "1.0.0",
  "description": "Jankx WordPress Theme with Gutenberg Blocks",
  "main": "index.js",
  "scripts": {
    "build:widget-renderer": "wp-scripts build resources/blocks/widget-renderer/index.js resources/blocks/widget-renderer/index.css --output-path=resources/blocks/widget-renderer/build",
    "dev:widget-renderer": "wp-scripts start resources/blocks/widget-renderer/index.js resources/blocks/widget-renderer/index.css --output-path=resources/blocks/widget-renderer/build",
    "format": "wp-scripts format",
    "lint:css": "wp-scripts lint-style",
    "lint:js": "wp-scripts lint-js",
    "lint:md:docs": "wp-scripts lint-md-docs",
    "lint:pkg-json": "wp-scripts lint-pkg-json",
    "packages-update": "wp-scripts packages-update",
    "plugin-zip": "wp-scripts plugin-zip",
    "test:e2e": "wp-scripts test-e2e",
    "test:unit": "wp-scripts test-unit-js"
  },
  "keywords": [
    "wordpress",
    "theme",
    "gutenberg",
    "blocks"
  ],
  "author": "Puleeno Nguyen",
  "license": "MIT",
  "devDependencies": {
    "@wordpress/scripts": "^26.19.0",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@wordpress/api-fetch": "^6.47.0",
    "@wordpress/block-editor": "^12.15.0",
    "@wordpress/blocks": "^12.29.0",
    "@wordpress/element": "^5.24.0",
    "@wordpress/i18n": "^4.47.0",
    "wp-scripts": "^0.0.1-security"
  }
}
