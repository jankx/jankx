        "lodash": "^4.17.19",
        "mini-css-extract-plugin": "^2.9.4",
        "npm-run-all": "^4.1.5",
        "postcss": "^8.1.14",
        "postcss-loader": "^8.2.0",
        "resolve-url-loader": "^5.0.0",
        "sass": "^1.85.1",
        "sass-loader": "^16.0.5",
        "typescript": "^5.9.2",
        "webpack-cli": "^6.0.1",
