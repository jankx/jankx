{**
 * Promotional Banner Loop Item Template
 * Used for promotional banner layout with featured content
 * All data is processed in the layout class, template only displays
 *}

<div class="{implode(' ', $content_classes)}">
    {if $show_thumbnail && $thumbnail.exists}
        <figure class="wp-block-view-featured-image wp-block-view-featured-image-promotional">
            <a href="{$permalink|noescape}">
                {$thumbnail.html|noescape}
            </a>
        </figure>
    {/if}

    <div class="wp-block-view-content-inner wp-block-view-content-inner-promotional">
        {if $show_title}
            <h2 class="wp-block-view-title wp-block-view-title-promotional">
                <a href="{$permalink|noescape}">
                    {$title|noescape}
                </a>
            </h2>
        {/if}

        {if $show_date && $date}
            <div class="wp-block-view-date wp-block-view-date-promotional">
                <time datetime="{$date.datetime|noescape}">
                    {$date.formatted|noescape}
                </time>
            </div>
        {/if}

        {if $show_excerpt && $excerpt}
            <div class="wp-block-view-excerpt wp-block-view-excerpt-promotional">
                <p class="wp-block-view-excerpt__excerpt">
                    {$excerpt|noescape}
                </p>
            </div>
        {/if}

        {if $show_read_more}
            <div class="wp-block-view-read-more wp-block-view-read-more-promotional">
                <a href="{$permalink|noescape}" class="wp-block-view-read-more__link wp-block-view-read-more__link-promotional">
                    {$read_more_text|noescape}
                </a>
            </div>
        {/if}
    </div>
</div>
