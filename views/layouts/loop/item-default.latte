{**
 * Default Loop Item Template
 * Standard template for individual loop items
 * All data is processed in the layout class, template only displays
 *}

<div class="{implode(' ', $content_classes)}">
    {if $show_thumbnail && $thumbnail['exists']}
        <figure class="wp-block-view-featured-image">
            <a href="{$permalink|noescape}">
                {$thumbnail['html']|noescape}
            </a>
        </figure>
    {/if}

    <div class="wp-block-view-content-inner">
        {if $show_title}
            <h3 class="wp-block-view-title">
                <a href="{$permalink|noescape}">
                    {$title|noescape}
                </a>
            </h3>
        {/if}

        {if $show_date && $date}
            <div class="wp-block-view-date">
                <time datetime="{$date['datetime']|noescape}">
                    {$date['formatted']|noescape}
                </time>
            </div>
        {/if}

        {if $show_excerpt && $excerpt}
            <div class="wp-block-view-excerpt">
                <p class="wp-block-view-excerpt__excerpt">
                    {$excerpt|noescape}
                </p>
            </div>
        {/if}

        {if $show_read_more}
            <div class="wp-block-view-read-more">
                <a href="{$permalink|noescape}" class="wp-block-view-read-more__link">
                    {$read_more_text|noescape}
                </a>
            </div>
        {/if}
    </div>
</div>
