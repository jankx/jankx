{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "jankx/views",
    "version": "1.0.0",
    "title": "Post Views",
    "category": "widgets",
    "icon": "visibility",
    "description": "Display post view count",
    "keywords": ["views", "post", "count", "metrics"],
    "textdomain": "jankx",
    "editorScript": "file:./build/index.js",
    "editorStyle": "file:./build/style-index.css",
    "style": "file:./build/style-index.css",
    "render": "file:./render.php",
    "supports": {
        "html": false,
        "align": ["left", "center", "right"]
    },
    "attributes": {
        "showIcon": {
            "type": "boolean",
            "default": true
        },
        "showLabel": {
            "type": "boolean",
            "default": true
        },
        "label": {
            "type": "string",
            "default": "lượt xem"
        },
        "postId": {
            "type": "number",
            "default": 0
        }
    }
}
