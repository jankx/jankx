{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "jankx/embla-carousel-presentation-slide",
  "version": "1.0.0",
  "title": "Presentation Slide",
  "category": "jankx",
  "icon": "slides",
  "description": "Một slide thuyết trình 16:9 trong Presentation Carousel.",
  "parent": ["jankx/embla-carousel"],
  "usesContext": ["jankx/embla-carousel-variant"],
  "supports": {
    "html": false
  },
  "attributes": {
    "layout": {
      "type": "string",
      "default": "title",
      "enum": ["title", "split", "stats", "quote", "bullets"]
    },
    "title": {
      "type": "string",
      "default": "Tiêu đề slide"
    },
    "subtitle": {
      "type": "string",
      "default": ""
    },
    "bodyText": {
      "type": "string",
      "default": ""
    },
    "bullets": {
      "type": "array",
      "default": [],
      "items": { "type": "string" }
    },
    "statsNumber": {
      "type": "string",
      "default": ""
    },
    "statsLabel": {
      "type": "string",
      "default": ""
    },
    "quoteText": {
      "type": "string",
      "default": ""
    },
    "quoteAuthor": {
      "type": "string",
      "default": ""
    },
    "quoteRole": {
      "type": "string",
      "default": ""
    },
    "theme": {
      "type": "string",
      "default": "dark",
      "enum": ["dark", "light", "indigo", "slate", "forest"]
    },
    "presenterNotes": {
      "type": "string",
      "default": ""
    }
  },
  "editorScript": "file:./build/index.js",
  "style": "file:./build/style.css"
}
