{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "jankx/embla-carousel",
  "version": "1.0.0",
  "title": "Embla Carousel",
  "category": "jankx",
  "icon": "slides",
  "description": "Hệ thống Embla Carousel đa năng với 3 chế độ: Banner, InnerBlocks Cards, Presentation Slides.",
  "keywords": ["carousel", "slider", "embla", "banner", "presentation", "jankx"],
  "supports": {
    "align": ["wide", "full"],
    "html": false,
    "color": {
      "background": true,
      "text": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "providesContext": {
    "jankx/embla-carousel-variant": "variant"
  },
  "attributes": {
    "variant": {
      "type": "string",
      "default": "banner",
      "enum": ["banner", "inner-blocks", "presentation"]
    },
    "loop": {
      "type": "boolean",
      "default": true
    },
    "align": {
      "type": "string",
      "default": "center",
      "enum": ["start", "center", "end"]
    },
    "dragFree": {
      "type": "boolean",
      "default": false
    },
    "draggable": {
      "type": "boolean",
      "default": true
    },
    "keyboardNavigation": {
      "type": "boolean",
      "default": true
    },
    "parallaxDrag": {
      "type": "boolean",
      "default": true
    },
    "transitionType": {
      "type": "string",
      "default": "slide",
      "enum": ["slide", "fade", "crossfade"]
    },
    "duration": {
      "type": "number",
      "default": 25
    },
    "autoplay": {
      "type": "boolean",
      "default": true
    },
    "autoplayDelay": {
      "type": "number",
      "default": 4500
    },
    "stopOnInteraction": {
      "type": "boolean",
      "default": true
    },
    "stopOnMouseEnter": {
      "type": "boolean",
      "default": true
    },
    "showArrows": {
      "type": "boolean",
      "default": true
    },
    "arrowStyle": {
      "type": "string",
      "default": "round",
      "enum": ["round", "square", "pill", "minimal"]
    },
    "showDots": {
      "type": "boolean",
      "default": true
    },
    "dotType": {
      "type": "string",
      "default": "bullets",
      "enum": ["bullets", "bars", "numbers", "counter"]
    },
    "showProgress": {
      "type": "boolean",
      "default": true
    },
    "slidesPerView": {
      "type": "number",
      "default": 3
    },
    "gap": {
      "type": "number",
      "default": 20
    },
    "aspectRatio": {
      "type": "string",
      "default": "16:9",
      "enum": ["16:9", "21:9", "4:3", "auto"]
    },
    "kenBurns": {
      "type": "boolean",
      "default": true
    },
    "showShadow": {
      "type": "boolean",
      "default": true
    },
    "shadowIntensity": {
      "type": "number",
      "default": 3
    },
    "borderRadius": {
      "type": "number",
      "default": 16
    }
  },
  "editorScript": "file:./build/index.js",
  "editorStyle": "file:./build/editor.css",
  "style": "file:./build/style.css",
  "viewScript": "file:../../build/view.js"
}
