{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "jankx/embla-carousel-card",
  "version": "1.0.0",
  "title": "Carousel Card",
  "category": "jankx",
  "icon": "id",
  "description": "Một card nội dung trong InnerBlocks Carousel.",
  "parent": ["jankx/embla-carousel"],
  "usesContext": ["jankx/embla-carousel-variant"],
  "supports": {
    "html": false
  },
  "attributes": {
    "category": {
      "type": "string",
      "default": "MỚI"
    },
    "title": {
      "type": "string",
      "default": "Tiêu đề card"
    },
    "description": {
      "type": "string",
      "default": "Mô tả nội dung card."
    },
    "badgeText": {
      "type": "string",
      "default": ""
    },
    "metricValue": {
      "type": "string",
      "default": ""
    },
    "metricLabel": {
      "type": "string",
      "default": ""
    },
    "actionText": {
      "type": "string",
      "default": "Chi tiết"
    },
    "cardColor": {
      "type": "string",
      "default": "slate",
      "enum": ["slate", "indigo", "emerald", "amber", "rose"]
    },
    "cardBgColor": {
      "type": "string",
      "default": "#ffffff"
    },
    "cardBorderColor": {
      "type": "string",
      "default": "#e2e8f0"
    },
    "cardTitleColor": {
      "type": "string",
      "default": "#0f172a"
    },
    "cardDescriptionColor": {
      "type": "string",
      "default": "#475569"
    },
    "cardBadgeBgColor": {
      "type": "string",
      "default": "#f1f5f9"
    },
    "cardBadgeColor": {
      "type": "string",
      "default": "#475569"
    },
    "cardMetricColor": {
      "type": "string",
      "default": "#0f172a"
    },
    "cardFooterBorderColor": {
      "type": "string",
      "default": "#f1f5f9"
    },
    "cardHoverBorderColor": {
      "type": "string",
      "default": "#94a3b8"
    }
  },
  "editorScript": "file:./build/index.js",
  "style": "file:./build/style.css"
}
