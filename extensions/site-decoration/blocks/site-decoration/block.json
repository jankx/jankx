{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "jankx/site-decoration",
    "version": "1.0.0",
    "title": "Site Decoration",
    "category": "design",
    "icon": "art",
    "description": "Decorate a footer, header, or cover section and its child blocks.",
    "textdomain": "jankx",
    "editorScript": "file:../../dist/site-decoration/index.js",
    "style": "file:../../dist/style-site-decoration.css",
    "editorStyle": "file:../../dist/style-site-decoration.css",
    "attributes": {
        "className": { "type": "string" }
    },
    "supports": {
        "anchor": true,
        "html": false,
        "spacing": {
            "margin": true,
            "padding": true,
            "blockGap": true
        },
        "color": {
            "background": true,
            "text": true,
            "gradients": true
        },
        "layout": {
            "allowSwitching": true,
            "allowInheriting": false
        }
    }
}
