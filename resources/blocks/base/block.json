{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "jankx-swiper/base",
  "version": "1.0.0",
  "title": "Base",
  "category": "jankx",
  "description": "Display fixed content in a sliding or carousel layout.",
  "example": {
    "attributes": {
      "preview": true
    },
    "viewportWidth": 410
