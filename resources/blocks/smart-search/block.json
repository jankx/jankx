{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "jankx/smart-search",
  "version": "1.0.0",
  "title": "Smart Search",
  "category": "jankx",
  "icon": "search",
  "description": "Advanced search form builder with autocomplete and suggestions",
  "textdomain": "jankx",
  "editorScript": "file:./build/index.js",
  "editorStyle": "file:./build/editor.css",
  "style": "file:./build/style.css",
  "viewScript": "file:./build/frontend.js",
  "supports": {
    "html": false,
    "align": ["wide", "full"],
    "anchor": true,
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "color": {
      "background": true,
      "text": true,
      "link": true,
      "gradients": true
    },
    "background": {
      "backgroundImage": true,
      "backgroundSize": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "__experimentalLayout": {
      "allowSwitching": true,
      "allowInheriting": true,
      "default": {
        "type": "constrained"
      }
    }
  },
  "attributes": {
    "placeholder": {
      "type": "string",
      "default": "Search..."
    },
    "showLabel": {
      "type": "boolean",
      "default": false
    },
    "labelText": {
      "type": "string",
      "default": "Search"
    },
    "enablePostTypeFilter": {
      "type": "boolean",
      "default": false
    },
    "postTypes": {
      "type": "array",
      "default": []
    },
    "enableTaxonomyFilter": {
      "type": "boolean",
      "default": false
    },
    "taxonomy": {
      "type": "string",
      "default": "category"
    },
    "showIcon": {
      "type": "boolean",
      "default": true
    },
    "iconPosition": {
      "type": "string",
      "enum": ["inside", "outside"],
      "default": "inside"
    },
    "buttonPosition": {
      "type": "string",
      "enum": ["inside", "outside"],
      "default": "inside"
    },
    "enableAutocomplete": {
      "type": "boolean",
      "default": false
    },
    "autocompleteDelay": {
      "type": "number",
      "default": 300
    },
    "autocompleteMinChars": {
      "type": "number",
      "default": 2
    },
    "autocompleteMaxResults": {
      "type": "number",
      "default": 10
    },
    "showSuggestions": {
      "type": "boolean",
      "default": true
    },
    "suggestionShowPosts": {
      "type": "boolean",
      "default": true
    },
    "suggestionShowPostTypes": {
      "type": "boolean",
      "default": false
    },
    "suggestionShowUsers": {
      "type": "boolean",
      "default": false
    },
    "suggestionShowTaxonomy": {
      "type": "boolean",
      "default": false
    },
    "suggestionShowTags": {
      "type": "boolean",
      "default": false
    },
    "searchUrl": {
      "type": "string",
      "default": ""
    },
    "formLayout": {
      "type": "string",
      "enum": ["horizontal", "vertical"],
      "default": "horizontal"
    }
  }
}

