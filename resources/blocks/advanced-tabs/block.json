{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "jankx/advanced-tabs",
    "title": "Advanced Tabs",
    "category": "jankx",
    "icon": "editor-table",
    "description": "Display content in interactive tabs with customizable styling",
    "keywords": ["tabs", "content", "navigation", "interactive"],
    "textdomain": "jankx",
    "supports": {
        "html": false,
        "anchor": true,
        "align": ["wide", "full"],
        "spacing": {
            "margin": true,
            "padding": true
        }
    },
    "example": {
        "attributes": {
            "tab1": {
                "title": "Tab 1",
                "content": "<p>Tab 1 content</p>"
            },
            "tab2": {
                "title": "Tab 2",
                "content": "<p>Tab 2 content</p>"
            },
            "tab3": {
                "title": "Tab 3",
                "content": "<p>Tab 3 content</p>"
            }
        }
    },
    "attributes": {
        "uniqueId": {
            "type": "string"
        },
        "tabTitles": {
            "type": "array",
            "default": [
                {
                    "id": "1",
                    "title": "Tab 1",
                    "hasMedia": false,
                    "mediaType": "iconLibrary",
                    "icon": "0-circle",
                    "customSVG": ""
                },
                {
                    "id": "2",
                    "title": "Tab 2",
                    "hasMedia": false,
                    "mediaType": "iconLibrary",
                    "icon": "0-circle",
                    "customSVG": ""
                },
                {
                    "id": "3",
                    "title": "Tab 3",
                    "hasMedia": false,
                    "mediaType": "iconLibrary",
                    "icon": "0-circle",
                    "customSVG": ""
                }
            ]
        },
        "tabChildCount": {
            "type": "number",
            "default": 3
        },
        "activeTab": {
            "type": "string",
            "default": "1"
        },
        "iconPosition": {
            "type": "string",
            "default": "left"
        },
        "showSeparator": {
            "type": "boolean",
            "default": true
        },
        "className": {
            "type": "string"
        }
    },
    "editorScript": "file:./build/index.js",
    "style": "file:./build/style.css",
    "editorStyle": "file:./build/editor.css",
    "viewScript": "file:./build/view.js"
}