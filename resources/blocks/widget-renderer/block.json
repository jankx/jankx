{
    "name": "jankx/widget-renderer",
    "title": "Widget Renderer",
    "category": "widgets",
    "icon": "admin-generic",
    "description": "Render WordPress widgets in Gutenberg blocks",
    "keywords": ["widget", "sidebar", "render"],
    "textdomain": "jankx",
    "supports": {
        "html": false,
        "align": ["wide", "full"]
    },
    "attributes": {
        "widgetId": {
            "type": "string",
            "default": ""
        },
        "widgetType": {
            "type": "string",
            "default": ""
        },
        "title": {
            "type": "string",
            "default": ""
        },
        "showTitle": {
            "type": "boolean",
            "default": true
        },
        "className": {
            "type": "string"
        }
    },
    "editorScript": "file:./build/index.js",
    "style": "file:./build/index.css.css"
}