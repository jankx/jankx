{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "jankx/swiper-inner-blocks-overlay",
  "title": "Swiper Overlay Inner Blocks",
  "category": "jankx",
  "description": "Overlay container for persistent content fixed over Swiper slides",
  "textdomain": "jankx",
  "parent": ["jankx/swiper"],
  "supports": {
    "html": false,
    "anchor": true,
    "align": ["wide", "full"],
    "spacing": {
      "margin": true,
      "padding": true
    },
    "color": {
      "background": true,
      "text": true
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    }
  },
  "attributes": {
    "className": {
      "type": "string"
    }
  },
  "editorScript": "file:./build/index.js",
  "editorStyle": "file:./build/editor.css",
  "style": "file:./build/style.css"
}
