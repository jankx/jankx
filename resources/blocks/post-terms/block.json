{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "jankx/post-terms",
    "title": "Post Terms",
    "category": "jankx",
    "icon": "category",
    "description": "Hiển thị các taxonomies (category, tag, product_cat...) của post hiện tại.",
    "textdomain": "jankx",
    "usesContext": [
        "postId",
        "postType"
    ],
    "attributes": {
        "postTypes": {
            "type": "array",
            "default": []
        },
        "taxonomy": {
            "type": "string",
            "default": "category"
        },
        "displayStyle": {
            "type": "string",
            "default": "default"
        },
        "separator": {
            "type": "string",
            "default": ", "
        },
        "layout": {
            "type": "string",
            "default": "inline"
        },
        "linkToTerm": {
            "type": "boolean",
            "default": true
        },
        "termTextColor": {
            "type": "string"
        },
        "termBackgroundColor": {
            "type": "string"
        }
    },
    "supports": {
        "html": false,
        "color": {
            "text": true,
            "background": true,
            "link": true
        },
        "typography": {
            "fontSize": true,
            "lineHeight": true,
            "fontStyle": true,
            "fontWeight": true,
            "textTransform": true,
            "letterSpacing": true
        },
        "spacing": {
            "margin": true,
            "padding": true,
            "blockGap": true
        },
        "__experimentalBorder": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        },
        "layout": {
            "allowSwitching": false,
            "allowInheriting": false,
            "default": {
                "type": "flex"
            }
        }
    },
    "editorScript": "file:../../dist/blocks/post-terms/index.js",
    "style": "file:../../dist/blocks/post-terms/style.css"
}