{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "jankx/swiper",
  "title": "Swiper",
  "category": "jankx",
  "description": "Modern touch slider with hardware accelerated transitions",
  "keywords": ["slider", "swiper", "carousel", "gallery", "slideshow"],
  "textdomain": "jankx",
  "attributes": {
    "slidesPerView": {
      "type": "number",
      "default": 1
    },
    "spaceBetween": {
      "type": "number",
      "default": 30
    },
    "loop": {
      "type": "boolean",
      "default": true
    },
    "autoplay": {
      "type": "boolean",
      "default": false
    },
    "autoplayDelay": {
      "type": "number",
      "default": 3000
    },
    "speed": {
      "type": "number",
      "default": 300
    },
    "navigation": {
      "type": "boolean",
      "default": true
    },
    "pagination": {
      "type": "boolean",
      "default": true
    },
    "effect": {
      "type": "string",
      "enum": ["slide", "fade", "cube", "coverflow", "flip", "cards"],
      "default": "slide"
    },
    "height": {
      "type": "number",
      "default": 500
    },
    "minHeight": {
      "type": "number",
      "default": 300
    },
    "contentMode": {
      "type": "string",
      "enum": ["slides", "gallery"],
      "default": "slides"
    },
    "galleryImages": {
      "type": "array",
      "default": []
    },
    "className": {
      "type": "string"
    },
    "anchor": {
      "type": "string"
    }
  },
  "supports": {
    "html": false,
    "anchor": true,
    "align": ["wide", "full"],
    "spacing": {
      "margin": true,
      "padding": true
    },
    "color": {
      "background": true,
      "text": true
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true,
      "__experimentalDefaultControls": {
        "radius": true
      }
    }
  },
  "providesContext": {
    "jankx/swiperId": "anchor"
  },
  "editorScript": "file:./build/index.js",
  "editorStyle": "file:./build/editor.css",
  "viewScript": "file:./build/view.js",
  "style": "file:./build/style.css"
}
