{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "name": "jankx/gallery-builder",
    "title": "Gallery Builder",
    "category": "media",
    "icon": "format-gallery",
    "description": "Professional gallery viewer with slideshow, navigation controls, and rich content editing capabilities.",
    "keywords": ["gallery", "slideshow", "carousel", "images", "viewer", "builder"],
    "textdomain": "jankx",
    "supports": {
        "html": false,
        "anchor": true,
        "align": ["wide", "full"],
        "color": {
            "background": true,
            "text": true,
            "gradients": true,
            "link": true
        },
        "spacing": {
            "margin": true,
            "padding": true,
            "blockGap": true
        },
        "border": {
            "color": true,
            "width": true,
            "style": true,
            "radius": true
        },
        "background": {
            "backgroundImage": true,
            "backgroundPosition": true,
            "backgroundRepeat": true,
            "backgroundSize": true
        },
        "dimensions": {
            "minHeight": true
        },
        "typography": {
            "fontSize": true,
            "lineHeight": true,
            "fontFamily": true,
            "fontWeight": true,
            "fontStyle": true,
            "textTransform": true,
            "textDecoration": true,
            "letterSpacing": true
        }
    },
    "attributes": {
        "galleryId": {
            "type": "string"
        },
        "items": {
            "type": "array",
            "default": []
        },
        "autoplay": {
            "type": "boolean",
            "default": false
        },
        "autoplayDelay": {
            "type": "number",
            "default": 5000
        },
        "showThumbnails": {
            "type": "boolean",
            "default": true
        },
        "showNavigation": {
            "type": "boolean",
            "default": true
        },
        "showPagination": {
            "type": "boolean",
            "default": true
        },
        "showCaptions": {
            "type": "boolean",
            "default": true
        },
        "thumbnailPosition": {
            "type": "string",
            "default": "top"
        },
        "imageSize": {
            "type": "string",
            "default": "large"
        },
        "aspectRatio": {
            "type": "string",
            "default": "16:9"
        },
        "transitionEffect": {
            "type": "string",
            "default": "slide"
        },
        "transitionDuration": {
            "type": "number",
            "default": 500
        },
        "enableFullscreen": {
            "type": "boolean",
            "default": true
        },
        "fullscreenAutoplay": {
            "type": "boolean",
            "default": true
        },
        "fullscreenAutoplayDelay": {
            "type": "number",
            "default": 4000
        },
        "fullscreenText": {
            "type": "string",
            "default": ""
        },
        "captionPosition": {
            "type": "string",
            "default": "overlay"
        }
    },
    "editorScript": "file:./build/index.js",
    "style": "file:./build/style.css",
    "editorStyle": "file:./build/editor.css"
}
