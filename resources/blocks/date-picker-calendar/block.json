{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "jankx/date-picker-calendar",
  "version": "1.0.0",
  "title": "Date Picker Calendar",
  "category": "widgets",
  "icon": "calendar-alt",
  "description": "A calendar block with date picker functionality supporting outline and fill modes",
  "keywords": ["calendar", "date", "picker", "schedule"],
  "textdomain": "jankx",
  "supports": {
    "html": false,
    "align": ["wide", "full"],
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "attributes": {
    "selectedDates": {
      "type": "array",
      "default": []
    },
    "currentMonth": {
      "type": "number",
      "default": 3
    },
    "currentYear": {
      "type": "number",
      "default": 2026
    },
    "showNavigation": {
      "type": "boolean",
      "default": true
    },
    "showWeekdays": {
      "type": "boolean",
      "default": true
    }
  },
  "providesContext": {},
  "usesContext": [],
  "editorScript": "file:./build/index.js",
  "editorStyle": "file:./build/editor.css",
  "style": "file:./build/style-index.css"
}
