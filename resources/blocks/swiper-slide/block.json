{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "jankx/swiper-slide",
    "version": "1.0.0",
    "title": "Swiper Slide",
    "category": "design",
    "icon": "format-image",
    "description": "Individual slide for the Swiper slider with image and content.",
    "keywords": ["slide", "image", "content"],
    "textdomain": "jankx",
    "supports": {
        "html": false,
        "align": ["wide", "full"]
    },
    "parent": ["jankx/swiper-slider"],
    "attributes": {
        "imageId": {
            "type": "number"
        },
        "imageUrl": {
            "type": "string"
        },
        "imageAlt": {
            "type": "string"
        },
        "title": {
            "type": "string"
        },
        "description": {
            "type": "string"
        },
        "linkUrl": {
            "type": "string"
        },
        "linkTarget": {
            "type": "string",
            "default": "_self"
        },
        "className": {
            "type": "string"
        }
    },
    "editorScript": "file:./build/index.js",
    "style": "file:./build/style.css",
    "editorStyle": "file:./build/editor.css"
}
