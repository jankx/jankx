{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "jankx/advanced-posts",
  "title": "Advanced Posts",
  "description": "Display multiple posts with query options.",
  "category": "widgets",
  "icon": "admin-page",
  "textdomain": "jankx",
  "attributes": {
    "align": { "type": "string", "enum": ["center", "wide", "full"] },
    "postType": { "type": "string", "default": "post" },
    "postsToShow": { "type": "number", "default": 5 },
    "offset": { "type": "number", "default": 0 },
    "order": { "type": "string", "default": "desc" },
    "orderBy": { "type": "string", "default": "date" },
    "ignoreStickyPosts": { "type": "boolean", "default": true },
    "showAllPosts": { "type": "boolean", "default": false }
  },
  "supports": {
    "align": ["center", "wide", "full"],
    "html": false
  },
  "editorScript": "file:./build/index.js",
  "style": "file:./build/style.css",
  "editorStyle": "file:./build/editor.css"
}
