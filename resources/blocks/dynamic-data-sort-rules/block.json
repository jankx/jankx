{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "jankx/dynamic-data-sort-rules",
  "version": "1.0.0",
  "title": "Sort Rules",
  "category": "jankx",
  "icon": "sort",
  "description": "Sort dynamic data by multiple criteria using the same order options as the Query Settings panel.",
  "keywords": [
    "sort",
    "order",
    "orderby",
    "query",
    "rules"
  ],
  "textdomain": "jankx",
  "attributes": {
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "displayLabel": {
      "type": "string",
      "default": "Sắp xếp theo"
    },
    "rules": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object"
      }
    }
  },
  "supports": {
    "html": false,
    "inserter": true
  },
  "parent": [
    "jankx/dynamic-data-layout"
  ],
  "editorScript": "file:../../dist/blocks/dynamic-data-sort-rules/index.js",
  "editorStyle": "file:../../dist/blocks/dynamic-data-sort-rules/editor.css",
  "style": "file:../../dist/blocks/dynamic-data-sort-rules/style.css",
  "viewScript": "file:../../dist/blocks/dynamic-data-sort-rules/frontend.js"
}