{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "jankx/sticky-box",
  "title": "Sticky Box",
  "category": "jankx",
  "icon": "align-wide",
  "description": "Nhóm nội dung có hành vi sticky theo trục Y khi scroll tới.",
  "textdomain": "jankx",
  "attributes": {
    "stickyEnabled": {
      "type": "boolean",
      "default": true
    },
    "offsetTop": {
      "type": "number",
      "default": 16
    }
  },
  "supports": {
    "html": false,
    "align": ["wide", "full"],
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "__experimentalBorder": {
      "radius": true,
      "width": true,
      "color": true,
      "style": true
    }
  },
  "editorScript": "file:../../dist/blocks/sticky-box/index.js",
  "style": "file:../../dist/blocks/sticky-box/style.css",
  "editorStyle": "file:../../dist/blocks/sticky-box/editor.css"
}
