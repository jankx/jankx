{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "jankx/user-menu",
    "title": "User Menu",
    "category": "jankx",
    "icon": "admin-users",
    "description": "Hiển thị menu người dùng với trạng thái đăng nhập/đăng xuất và dropdown thông tin cá nhân.",
    "textdomain": "jankx",
    "attributes": {
        "showRegister": {
            "type": "boolean",
            "default": true
        },
        "showLogin": {
            "type": "boolean",
            "default": true
        },
        "showUserName": {
            "type": "boolean",
            "default": false
        },
        "greetingText": {
            "type": "string",
            "default": "Xin chào,"
        },
        "avatarSize": {
            "type": "number",
            "default": 35
        }
    },
    "supports": {
        "html": false,
        "align": ["wide", "full"],
        "spacing": {
            "margin": true,
            "padding": true,
            "blockGap": true,
            "__experimentalDefaultControls": {
                "margin": true,
                "padding": true
            }
        },
        "color": {
            "text": true,
            "background": true,
            "link": true,
            "__experimentalDefaultControls": {
                "text": true,
                "background": true
            }
        },
        "typography": {
            "fontSize": true,
            "lineHeight": true,
            "fontWeight": true,
            "__experimentalDefaultControls": {
                "fontSize": true
            }
        }
    },
    "editorScript": "file:../../dist/blocks/user-menu/index.js",
    "editorStyle": "file:../../dist/blocks/user-menu/editor.css",
    "style": "file:../../dist/blocks/user-menu/style.css"
}
