{
  "name": "jankx",
  "version": "2.0.0",
  "description": "Jankx WordPress Theme with Gutenberg Blocks",
  "main": "blocks/index.js",
  "scripts": {
    "format": "wp-scripts format",
    "lint:css": "wp-scripts lint-style",
    "lint:js": "wp-scripts lint-js",
    "lint:md:docs": "wp-scripts lint-md-docs",
    "lint:pkg-json": "wp-scripts lint-pkg-json",
    "packages-update": "wp-scripts packages-update",
    "plugin-zip": "wp-scripts plugin-zip",
    "test:e2e": "wp-scripts test-e2e",
    "test:unit": "wp-scripts test-unit-js",

    "build:language-switcher": "wp-scripts build blocks/language-switcher/index.js blocks/language-switcher/style.css --output-path=blocks/language-switcher/build && cp blocks/language-switcher/editor.css blocks/language-switcher/build/",

    "dev:language-switcher": "wp-scripts start blocks/language-switcher/index.js blocks/language-switcher/style.css --output-path=blocks/language-switcher/build",

    "build": "run-p build:*",
    "dev": "run-p dev:*"
  },
  "keywords": [
    "wordpress",
    "theme",
    "gutenberg",
    "blocks"
  ],
  "author": "Puleeno Nguyen",
  "license": "MIT",
  "devDependencies": {
    "@wordpress/babel-preset-default": "^8.28.0",
    "@wordpress/scripts": "^26.19.0",
    "babel-loader": "^10.0.0",
    "webpack-cli": "^6.0.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0"
  },
  "dependencies": {
    "@wordpress/api-fetch": "^6.47.0",
    "@wordpress/block-editor": "^12.26.0",
    "@wordpress/blocks": "^12.29.0",
    "@wordpress/components": "^30.1.0",
    "@wordpress/element": "^5.24.0",
    "@wordpress/i18n": "^4.58.0",
    "@wordpress/icons": "^10.28.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "swiper": "^11.0.0"
  }
}
