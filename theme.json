{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "calc(100% - 200px)",
			"wideSize": "calc(100% - 200px)"
		},
		"spacing": {
			"padding": true,
			"margin": true,
			"blockGap": true,
			"units": [
				"px",
				"em",
				"rem",
				"%",
				"vw",
				"vh"
			],
			"spacingScale": {
				"steps": 7,
				"operator": "+",
				"increment": 0.5,
				"mediumStep": 1.5
			},
			"spacingSizes": [
				{
					"size": "40px",
					"slug": "40",
					"name": "40"
				}
			]
		},
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"color": "#FFFFFF",
					"name": "Base",
					"slug": "base"
				},
				{
					"color": "#111111",
					"name": "Contrast",
					"slug": "contrast"
				},
				{
					"color": "#503AA8",
					"name": "Primary",
					"slug": "primary"
				},
				{
					"color": "#503AA8",
					"name": "Link Color",
					"slug": "link"
				},
				{
					"color": "#FFEE58",
					"name": "Accent 1",
					"slug": "accent-1"
				},
				{
					"color": "#F6CFF4",
					"name": "Accent 2",
					"slug": "accent-2"
				},
				{
					"color": "#503AA8",
					"name": "Accent 3",
					"slug": "accent-3"
				},
				{
					"color": "#686868",
					"name": "Accent 4",
					"slug": "accent-4"
				},
				{
					"color": "#FBFAF3",
					"name": "Accent 5",
					"slug": "accent-5"
				}
			]
		},
		"typography": {
			"customFontSize": true,
			"dropCap": true,
			"fontFamily": true,
			"fontSize": true,
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": true,
			"lineHeight": true,
			"textColumns": false,
			"textDecoration": true,
			"textTransform": true,
			"writingMode": false
		}
	},
	"styles": {
		"typography": {
			"fontSize": "16px",
			"lineHeight": "1.5"
		},
		"elements": {
			"link": {
				"color": "var(--wp--preset--color--link)",
				"typography": {
					"textDecoration": "none"
				}
			}
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "Header"
		},
		{
			"area": "footer",
			"name": "footer",
			"title": "Footer"
		},
		{
			"area": "header",
			"name": "offcanvas",
			"title": "Offcanvas"
		},
		{
			"area": "uncategorized",
			"name": "sidebar",
			"title": "Sidebar"
		}
	],
	"customTemplates": [
		{
			"name": "page-no-title",
			"postTypes": [
				"page"
			],
			"title": "Page No Title"
		}
	]
}