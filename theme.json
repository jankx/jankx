{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "1200px",
			"wideSize": "1400px"
		},
		"spacing": {
			"padding": true,
			"margin": true,
			"blockGap": true,
			"units": [
				"px",
				"em",
				"rem",
				"%",
				"vw",
				"vh"
			]
		},
		"color": {
			"defaultDuotone": false,
			"defaultGradients": true,
			"defaultPalette": false,
			"palette": [
				{
					"slug": "base",
					"color": "#FFFFFF",
					"name": "Base (White)"
				},
				{
					"slug": "contrast",
					"color": "#0d1117",
					"name": "Contrast (Dark)"
				},
				{
					"slug": "primary",
					"color": "#007bff",
					"name": "Primary (Gaming Blue)"
				},
				{
					"slug": "secondary",
					"color": "#e83e8c",
					"name": "Secondary (Esports Pink)"
				},
				{
					"slug": "accent-game",
					"color": "#17a2b8",
					"name": "Game Accent (Cyan)"
				},
				{
					"slug": "light-bg",
					"color": "#F9FAFB",
					"name": "Light Background"
				},
				{
					"slug": "dark-text",
					"color": "#111827",
					"name": "Dark Text"
				}
			],
			"gradients": [
				{
					"name": "Hero Overlay",
					"gradient": "linear-gradient(to top, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.6) 50%, transparent 100%)",
					"slug": "hero-overlay"
				}
			]
		},
		"typography": {
			"customFontSize": true,
			"dropCap": true,
			"fontFamilies": [
				{
					"fontFamily": "\"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen, Ubuntu, Cantarell, \"Open Sans\", \"Helvetica Neue\", sans-serif",
					"name": "Inter",
					"slug": "inter"
				},
				{
					"fontFamily": "\"Montserrat\", sans-serif",
					"name": "Montserrat",
					"slug": "montserrat"
				}
			],
			"fontSizes": [
				{
					"name": "Small",
					"size": "13px",
					"slug": "small"
				},
				{
					"name": "Normal",
					"size": "16px",
					"slug": "normal"
				},
				{
					"name": "Medium",
					"size": "20px",
					"slug": "medium"
				},
				{
					"name": "Large",
					"size": "32px",
					"slug": "large"
				}
			],
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": true,
			"lineHeight": true,
			"textColumns": false,
			"textDecoration": true,
			"textTransform": true,
			"writingMode": false
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--light-bg)",
			"text": "var(--wp--preset--color--dark-text)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--inter)",
			"fontSize": "16px",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--dark-text)"
				},
				"typography": {
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--primary)"
					}
				}
			},
			"h1": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--montserrat)",
					"fontWeight": "800"
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--montserrat)",
					"fontWeight": "700",
					"textTransform": "uppercase",
					"letterSpacing": "1px"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--montserrat)",
					"fontWeight": "700"
				}
			}
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "Header"
		},
		{
			"area": "footer",
			"name": "footer",
			"title": "Footer"
		}
	]
}